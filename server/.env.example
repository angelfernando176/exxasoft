# Copia este archivo como .env para trabajar en local. Nunca subas .env a GitHub.
# En DigitalOcean, estos valores van como variables de entorno cifradas.

# Credenciales del "Self Client" de https://api-console.zoho.com
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Se obtienen con: npm run setup -- CODIGO
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=

# Dominios según la región de la cuenta de Zoho (zoho.com, zoho.eu, zoho.in, zoho.com.au...)
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_MAIL_DOMAIN=https://mail.zoho.com

# Remitente (debe ser la cuenta de Zoho) y destinatario de las consultas
MAIL_FROM=fernando.escobar@exxasoft.com
MAIL_TO=fernando.escobar@exxasoft.com

# Sitios que pueden usar el servicio, separados por coma
ALLOWED_ORIGINS=https://exxasoft.com,https://www.exxasoft.com

PORT=8080

# Reseteo de contraseña (proyecto Supabase de Eco)
# service_role key: Supabase > Project Settings > API. Nunca va en el navegador.
SUPABASE_URL=https://jtrrqbnxhxxqjcpizjuy.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
